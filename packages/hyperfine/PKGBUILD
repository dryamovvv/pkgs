# Maintainer: dryamovvv <dryamovvv@users.noreply.github.com>
# Contributor: dryamovvv (Arch Linux package)
# Optimized for Raspberry Pi 5 (Cortex-A76)
pkgname=hyperfine
pkgver=1.20.0
pkgrel=1
pkgdesc="A command-line benchmarking tool, optimized for Raspberry Pi 5 (Cortex-A76)"
arch=('aarch64')
url="https://github.com/sharkdp/hyperfine"
license=('Apache-2.0')
options=('!debug')
depends=(
  'gcc-libs'
  'glibc'
)
makedepends=(
  'cargo'
)
source=("https://github.com/sharkdp/hyperfine/archive/refs/tags/v1.20.0.tar.gz")
sha256sums=('f90c3b096af568438be7da52336784635a962c9822f10f98e5ad11ae8c7f5c64')

prepare() {
  cd "$srcdir/hyperfine-1.20.0"
  cargo fetch --locked
}

build() {
  cd "$srcdir/hyperfine-1.20.0"
  export CFLAGS="-mcpu=cortex-a76+crypto -O2 -pipe"
  export CXXFLAGS="-mcpu=cortex-a76+crypto -O2 -pipe"
  export LDFLAGS="-Wl,-z,max-page-size=0x4000"
  export RUSTFLAGS="-C target-cpu=cortex-a76 -C opt-level=2"
  cargo build --release --locked
}

check() {
  cd "$srcdir/hyperfine-1.20.0"
  cargo test --workspace --all-targets --all-features || true
}

package() {
  cd "$srcdir/hyperfine-1.20.0"
  install -Dm755 "target/release/hyperfine" "$pkgdir/usr/bin/hyperfine"
  install -Dm644 "README.md" "$pkgdir/usr/share/doc/hyperfine/README.md"
  install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/hyperfine/LICENSE"
}
