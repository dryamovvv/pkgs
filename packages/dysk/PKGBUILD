# Maintainer: dryamovvv <dryamovvv@users.noreply.github.com>
# Contributor: dryamovvv (Arch Linux package)
# Optimized for Raspberry Pi 5 (Cortex-A76)
pkgname=dysk
pkgver=3.6.1
pkgrel=1
pkgdesc="A ls-like command for your disks, optimized for Raspberry Pi 5 (Cortex-A76)"
arch=('aarch64')
url="https://github.com/Canop/dysk"
license=('MIT')
options=('!debug')
depends=(
  'gcc-libs'
  'glibc'
)
makedepends=(
  'cargo'
)
source=("https://github.com/Canop/dysk/archive/refs/tags/v3.6.1.tar.gz")
sha256sums=('a712ce25f8c5867a29b699e5e22fed58b8884fb7ca112f01845c7a99b111dce5')

prepare() {
  cd "$srcdir/dysk-3.6.1"
  cargo fetch --locked
}

build() {
  cd "$srcdir/dysk-3.6.1"
  export CFLAGS="-mcpu=cortex-a76+crypto -O2 -pipe"
  export CXXFLAGS="-mcpu=cortex-a76+crypto -O2 -pipe"
  export LDFLAGS="-Wl,-z,max-page-size=0x4000"
  export RUSTFLAGS="-C target-cpu=cortex-a76 -C opt-level=2"
  cargo build --release --locked
}

check() {
  cd "$srcdir/dysk-3.6.1"
  cargo test --workspace --all-targets --all-features || true
}

package() {
  cd "$srcdir/dysk-3.6.1"
  install -Dm755 "target/release/dysk" "$pkgdir/usr/bin/dysk"
  install -Dm644 "README.md" "$pkgdir/usr/share/doc/dysk/README.md"
  install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/dysk/LICENSE"
}
