# Maintainer: dryamovvv <dryamovvv@users.noreply.github.com>
# Contributor: dryamovvv (Arch Linux package)
# Optimized for Raspberry Pi 5 (Cortex-A76)
pkgname=fzf
pkgver=0.50.0
pkgrel=1
pkgdesc="A command-line fuzzy finder, optimized for Raspberry Pi 5 (Cortex-A76)"
arch=('aarch64')
url="https://github.com/junegunn/fzf"
license=('MIT')
options=('!debug')
depends=(
  'glibc'
)
makedepends=(
  'go'
)
source=("https://github.com/junegunn/fzf/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('ae4f49f8606a7d28498208fa1b93c5d3b890719eea97e02559e66160138b750c')

prepare() {
  cd "$srcdir/fzf-$pkgver"
  go mod download
}

build() {
  cd "$srcdir/fzf-$pkgver"
  export CFLAGS="-mcpu=cortex-a76+crypto -O2 -pipe"
  export CXXFLAGS="-mcpu=cortex-a76+crypto -O2 -pipe"
  export LDFLAGS="-Wl,-z,max-page-size=0x4000"
  export GOARCH=arm64
  export GOARM64=v8.2
  export FZF_VERSION=$pkgver
  export FZF_REVISION=r1

  go build \
    -a \
    -ldflags "-s -w -X main.version=$pkgver -X main.revision=r1 -extldflags=-Wl,-z,max-page-size=0x4000" \
    -trimpath \
    -o fzf
}

check() {
  cd "$srcdir/fzf-$pkgver"
  go test ./... || true
}

package() {
  cd "$srcdir/fzf-$pkgver"

  install -Dm755 fzf "$pkgdir/usr/bin/fzf"
  install -Dm755 bin/fzf-tmux "$pkgdir/usr/bin/fzf-tmux"

  install -Dm644 man/man1/fzf.1 "$pkgdir/usr/share/man/man1/fzf.1"
  install -Dm644 man/man1/fzf-tmux.1 "$pkgdir/usr/share/man/man1/fzf-tmux.1"

  install -Dm644 shell/completion.bash "$pkgdir/usr/share/bash-completion/completions/fzf"
  install -Dm644 shell/completion.zsh "$pkgdir/usr/share/zsh/site-functions/_fzf"
  install -Dm644 shell/completion.fish "$pkgdir/usr/share/fish/vendor_completions.d/fzf.fish"

  install -Dm644 shell/key-bindings.bash "$pkgdir/usr/share/fzf/key-bindings/bash/key-bindings.bash"
  install -Dm644 shell/key-bindings.zsh "$pkgdir/usr/share/fzf/key-bindings/zsh/key-bindings.zsh"
  install -Dm644 shell/key-bindings.fish "$pkgdir/usr/share/fzf/key-bindings/fish/key-bindings.fish"

  install -Dm644 README.md "$pkgdir/usr/share/doc/fzf/README.md"
  install -Dm644 CHANGELOG.md "$pkgdir/usr/share/doc/fzf/CHANGELOG.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/fzf/LICENSE"

  install -Dm644 shell/common.sh "$pkgdir/usr/share/fzf/shell/common.sh"
}
