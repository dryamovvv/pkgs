# Maintainer: dryamovvv <dryamovvv@users.noreply.github.com>
# Contributor: dryamovvv (Arch Linux package)
# Optimized for Raspberry Pi 5 (Cortex-A76)
pkgname=mdv
pkgver=0.1.1
pkgrel=1
pkgdesc="Browser-quality Markdown viewer for the terminal, optimized for Raspberry Pi 5 (Cortex-A76)"
arch=('aarch64')
url="https://github.com/posaune0423/mdv"
license=('MIT')
options=('!debug')
depends=(
  'gcc-libs'
  'glibc'
)
makedepends=(
  'cargo'
)
source=("git+https://github.com/posaune0423/mdv.git#commit=739511e")
sha256sums=('SKIP')

prepare() {
  cd "$srcdir/mdv"
  cargo fetch --locked
}

build() {
  cd "$srcdir/mdv"
  export CFLAGS="-mcpu=cortex-a76+crypto -O2 -pipe"
  export CXXFLAGS="-mcpu=cortex-a76+crypto -O2 -pipe"
  export LDFLAGS="-Wl,-z,max-page-size=0x4000"
  export RUSTFLAGS="-C target-cpu=cortex-a76 -C opt-level=2"
  cargo build --release --locked
}

check() {
  cd "$srcdir/mdv"
  cargo test --workspace --all-targets --all-features || true
}

package() {
  cd "$srcdir/mdv"
  install -Dm755 "target/release/mdv" "$pkgdir/usr/bin/mdv"
  install -Dm644 "README.md" "$pkgdir/usr/share/doc/mdv/README.md"
  install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/mdv/LICENSE"
}
