# Maintainer: dryamovvv <dryamovvv@users.noreply.github.com>
# Contributor: dryamovvv (Arch Linux package)
# Optimized for Raspberry Pi 5 (Cortex-A76)
pkgname=starship
pkgver=1.25.1
pkgrel=1
pkgdesc="The minimal, blazing-fast, and infinitely customizable prompt for any shell, optimized for Raspberry Pi 5 (Cortex-A76)"
arch=('aarch64')
url="https://github.com/starship/starship"
license=('ISC')
options=('!debug')
depends=(
  'gcc-libs'
  'glibc'
)
makedepends=(
  'cargo'
)
source=("https://github.com/starship/starship/archive/refs/tags/v1.25.1.tar.gz")
sha256sums=('521306b14066ee7e332d998ef5b5b6455fdc6085c52e86b6316a7cdc37bae1d8')

prepare() {
  cd "$srcdir/starship-1.25.1"
  cargo fetch --locked
}

build() {
  cd "$srcdir/starship-1.25.1"
  export CFLAGS="-mcpu=cortex-a76+crypto -O2 -pipe"
  export CXXFLAGS="-mcpu=cortex-a76+crypto -O2 -pipe"
  export LDFLAGS="-Wl,-z,max-page-size=0x4000"
  export RUSTFLAGS="-C target-cpu=cortex-a76 -C opt-level=2"
  cargo build --release --locked
}

check() {
  cd "$srcdir/starship-1.25.1"
  cargo test --workspace --all-targets --all-features || true
}

package() {
  cd "$srcdir/starship-1.25.1"
  install -Dm755 "target/release/starship" "$pkgdir/usr/bin/starship"
  install -Dm644 "README.md" "$pkgdir/usr/share/doc/starship/README.md"
  install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/starship/LICENSE"
}
