# Maintainer: dryamovvv <dryamovvv@users.noreply.github.com>
# Contributor: dryamovvv (Arch Linux package)
# Optimized for Raspberry Pi 5 (Cortex-A76)
pkgname=ripgrep
pkgver=15.1.0
pkgrel=1
pkgdesc="A tool for searching files by regex, like grep but faster, optimized for Raspberry Pi 5 (Cortex-A76)"
arch=('aarch64')
url="https://github.com/BurntSushi/ripgrep"
license=('Unlicense')
options=('!debug')
depends=(
  'gcc-libs'
  'glibc'
)
makedepends=(
  'cargo'
)
source=("https://github.com/BurntSushi/ripgrep/archive/refs/tags/15.1.0.tar.gz")
sha256sums=('046fa01a216793b8bd2750f9d68d4ad43986eb9c0d6122600f993906012972e8')

prepare() {
  cd "$srcdir/ripgrep-15.1.0"
  cargo fetch --locked
}

build() {
  cd "$srcdir/ripgrep-15.1.0"
  export CFLAGS="-mcpu=cortex-a76+crypto -O2 -pipe"
  export CXXFLAGS="-mcpu=cortex-a76+crypto -O2 -pipe"
  export LDFLAGS="-Wl,-z,max-page-size=0x4000"
  export RUSTFLAGS="-C target-cpu=cortex-a76 -C opt-level=2"
  cargo build --release --locked
}

check() {
  cd "$srcdir/ripgrep-15.1.0"
  cargo test --workspace --all-targets --all-features || true
}

package() {
  cd "$srcdir/ripgrep-15.1.0"
  install -Dm755 "target/release/rg" "$pkgdir/usr/bin/rg"
  install -Dm644 "README.md" "$pkgdir/usr/share/doc/ripgrep/README.md"
  install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/ripgrep/LICENSE"
}
