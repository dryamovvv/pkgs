# Maintainer: dryamovvv <dryamovvv@users.noreply.github.com>
# Contributor: dryamovvv (Arch Linux package)
# Optimized for Raspberry Pi 5 (Cortex-A76)
pkgname=taplo
pkgver=0.10.0
pkgrel=1
pkgdesc="A TOML toolkit written in Rust, optimized for Raspberry Pi 5 (Cortex-A76)"
arch=('aarch64')
url="https://github.com/tamasfe/taplo"
license=('MIT')
options=('!debug')
depends=(
  'gcc-libs'
  'glibc'
)
makedepends=(
  'cargo'
)
source=("https://github.com/tamasfe/taplo/archive/refs/tags/0.10.0.tar.gz")
sha256sums=('c2f7b3234fc62000689a476b462784db4d1bb2be6edcc186654b211f691efaf8')

prepare() {
  cd "$srcdir/taplo-0.10.0"
  cargo fetch --locked
}

build() {
  cd "$srcdir/taplo-0.10.0"
  export CFLAGS="-mcpu=cortex-a76+crypto -O2 -pipe"
  export CXXFLAGS="-mcpu=cortex-a76+crypto -O2 -pipe"
  export LDFLAGS="-Wl,-z,max-page-size=0x4000"
  export RUSTFLAGS="-C target-cpu=cortex-a76 -C opt-level=2"
  cargo build --release --locked
}

check() {
  cd "$srcdir/taplo-0.10.0"
  cargo test --workspace --all-targets --all-features || true
}

package() {
  cd "$srcdir/taplo-0.10.0"
  install -Dm755 "target/release/taplo" "$pkgdir/usr/bin/taplo"
  install -Dm644 "README.md" "$pkgdir/usr/share/doc/taplo/README.md"
  install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/taplo/LICENSE"
}
