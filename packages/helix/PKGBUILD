# Maintainer: dryamovvv <dryamovvv@users.noreply.github.com>
# Optimized for Raspberry Pi 5 (Cortex-A76)
pkgname=helix
pkgver=25.07.1
pkgrel=2
pkgdesc="A post-modern modal text editor optimized for Raspberry Pi 5 (Cortex-A76)"
arch=('aarch64')
url="https://helix-editor.com/"
license=('MPL-2.0')
options=('!debug' '!lto')
install=helix.install
depends=(
  'gcc-libs'
  'glibc'
)
makedepends=(
  'cargo'
  'git'
)
optdepends=(
  'helix-grammars: pre-built tree-sitter grammars (run hx --grammar fetch && hx --grammar build instead)'
  'python: Python language server support'
  'rust-analyzer: Rust language server support'
  'clang: C/C++ language server support'
  'typescript-language-server: TypeScript/JavaScript language server support'
  'gopls: Go language server support'
  'nil: Nix language server support'
)
provides=("hx")
conflicts=("hx")
backup=('etc/environment.d/helix.conf')
source=("https://github.com/helix-editor/helix/archive/refs/tags/$pkgver.tar.gz")
sha256sums=('27c8bc3eba46bc7bab1e3629c6b28ff94882eeff17366b3ea69cd8ceffba7541')

prepare() {
  cd "$srcdir/$pkgname-$pkgver"
  sed -i 's|dannylongeuay/tree-sitter-go-template|ngalaiko/tree-sitter-go-template|g' languages.toml
  cargo fetch --locked --target aarch64-unknown-linux-gnu
}

build() {
  cd "$srcdir/$pkgname-$pkgver"
  export CFLAGS="-mcpu=cortex-a76+crypto -O2 -pipe"
  export CXXFLAGS="-mcpu=cortex-a76+crypto -O2 -pipe"
  export LDFLAGS="-Wl,-z,max-page-size=0x4000"
  export RUSTFLAGS="-C target-cpu=cortex-a76 -C opt-level=2"
  cargo build --profile opt --locked --no-default-features --features git
}

check() {
  cd "$srcdir/$pkgname-$pkgver"
  cargo test --profile opt --locked --no-default-features --features git || true
}

package() {
  cd "$srcdir/$pkgname-$pkgver"

  install -Dm755 "target/opt/hx" "$pkgdir/usr/bin/hx"

  install -d "$pkgdir/usr/lib/helix/runtime"
  cp -r runtime/queries "$pkgdir/usr/lib/helix/runtime/"
  cp -r runtime/themes "$pkgdir/usr/lib/helix/runtime/"
  [ -d runtime/scripts ] && cp -r runtime/scripts "$pkgdir/usr/lib/helix/runtime/"

  install -Dm644 contrib/completion/hx.bash "$pkgdir/usr/share/bash-completion/completions/hx"
  install -Dm644 contrib/completion/hx.fish "$pkgdir/usr/share/fish/vendor_completions.d/hx.fish"
  install -Dm644 contrib/completion/hx.zsh "$pkgdir/usr/share/zsh/site-functions/_hx"

  install -Dm644 contrib/Helix.desktop "$pkgdir/usr/share/applications/Helix.desktop"
  install -Dm644 contrib/helix.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/helix.png"

  install -Dm644 README.md "$pkgdir/usr/share/doc/helix/README.md"

  install -Dm644 /dev/stdin "$pkgdir/etc/environment.d/helix.conf" <<EOF
HELIX_RUNTIME=/usr/lib/helix/runtime
EOF
}