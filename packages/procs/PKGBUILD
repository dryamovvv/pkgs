# Maintainer: dryamovvv <dryamovvv@users.noreply.github.com>
# Contributor: dryamovvv (Arch Linux package)
# Optimized for Raspberry Pi 5 (Cortex-A76)
pkgname=procs
pkgver=0.14.11
pkgrel=1
pkgdesc="A modern replacement for ps written in Rust, optimized for Raspberry Pi 5 (Cortex-A76)"
arch=('aarch64')
url="https://github.com/dalance/procs"
license=('MIT')
options=('!debug')
depends=(
  'gcc-libs'
  'glibc'
)
makedepends=(
  'cargo'
)
source=("https://github.com/dalance/procs/archive/refs/tags/v0.14.11.tar.gz")
sha256sums=('3d6b3561ce05362a092ea8488458f552d6636d3a280290e21f841c432cadf91a')

prepare() {
  cd "$srcdir/procs-0.14.11"
  cargo fetch --locked
}

build() {
  cd "$srcdir/procs-0.14.11"
  export CFLAGS="-mcpu=cortex-a76+crypto -O2 -pipe"
  export CXXFLAGS="-mcpu=cortex-a76+crypto -O2 -pipe"
  export LDFLAGS="-Wl,-z,max-page-size=0x4000"
  export RUSTFLAGS="-C target-cpu=cortex-a76 -C opt-level=2"
  cargo build --release --locked
}

check() {
  cd "$srcdir/procs-0.14.11"
  cargo test --workspace --all-targets --all-features || true
}

package() {
  cd "$srcdir/procs-0.14.11"
  install -Dm755 "target/release/procs" "$pkgdir/usr/bin/procs"
  install -Dm644 "README.md" "$pkgdir/usr/share/doc/procs/README.md"
  install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/procs/LICENSE"
}
