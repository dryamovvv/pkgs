# Maintainer: dryamovvv <dryamovvv@users.noreply.github.com>
# Optimized for Raspberry Pi 5 (Cortex-A76)
pkgname=bat
pkgver=0.26.1
pkgrel=1
pkgdesc="A cat(1) clone with wings — optimized for Raspberry Pi 5 (Cortex-A76)"
arch=('aarch64')
url="https://github.com/sharkdp/bat"
license=('MIT' 'Apache-2.0')
options=('!debug')
depends=(
  'gcc-libs'
  'glibc'
  'oniguruma'
  'zlib'
  'less'
)
makedepends=(
  'cargo'
  'pkgconf'
)
source=("https://github.com/sharkdp/bat/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('4474de87e084953eefc1120cf905a79f72bbbf85091e30cf37c9214eafcaa9c9')

prepare() {
  cd "$srcdir/bat-$pkgver"
  cargo fetch --locked --target aarch64-unknown-linux-gnu
}

build() {
  cd "$srcdir/bat-$pkgver"
  export CFLAGS="-mcpu=cortex-a76+crypto -O2 -pipe"
  export CXXFLAGS="-mcpu=cortex-a76+crypto -O2 -pipe"
  export LDFLAGS="-Wl,-z,max-page-size=0x4000"
  export RUSTFLAGS="-C target-cpu=cortex-a76 -C opt-level=2"
  cargo build --release --locked \
    --features git,vendored-libgit2,lessopen,regex-onig
}

check() {
  cd "$srcdir/bat-$pkgver"
  cargo test --release --locked \
    --features git,vendored-libgit2,lessopen,regex-onig || true
}

package() {
  cd "$srcdir/bat-$pkgver"

  install -Dm755 "target/release/bat" "$pkgdir/usr/bin/bat"

  install -d "$pkgdir/usr/share/bash-completion/completions"
  install -d "$pkgdir/usr/share/zsh/site-functions"
  install -d "$pkgdir/usr/share/fish/vendor_completions.d"
  ./target/release/bat --completion bash > "$pkgdir/usr/share/bash-completion/completions/bat"
  ./target/release/bat --completion zsh > "$pkgdir/usr/share/zsh/site-functions/_bat"
  ./target/release/bat --completion fish > "$pkgdir/usr/share/fish/vendor_completions.d/bat.fish"

  install -Dm644 README.md "$pkgdir/usr/share/doc/bat/README.md"
  install -Dm644 LICENSE-MIT "$pkgdir/usr/share/licenses/bat/LICENSE-MIT"
  install -Dm644 LICENSE-APACHE "$pkgdir/usr/share/licenses/bat/LICENSE-APACHE"
}
