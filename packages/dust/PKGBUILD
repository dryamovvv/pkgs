# Maintainer: dryamovvv <dryamovvv@users.noreply.github.com>
# Contributor: dryamovvv (Arch Linux package)
# Optimized for Raspberry Pi 5 (Cortex-A76)
pkgname=dust
pkgver=1.2.4
pkgrel=2
pkgdesc="A more intuitive version of du in Rust, optimized for Raspberry Pi 5 (Cortex-A76)"
arch=('aarch64')
url="https://github.com/bootandy/dust"
license=('Apache-2.0')
options=('!debug')
depends=(
  'gcc-libs'
  'glibc'
)
makedepends=(
  'cargo'
)
source=("https://github.com/bootandy/dust/archive/refs/tags/v1.2.4.tar.gz")
sha256sums=('2f6768534bd01727234e67f1dd3754c9547aa18c715f6ee52094e881ebac50e3')

prepare() {
  cd "$srcdir/dust-1.2.4"
  cargo fetch --locked
}

build() {
  cd "$srcdir/dust-1.2.4"
  export CFLAGS="-mcpu=cortex-a76+crypto -O2 -pipe"
  export CXXFLAGS="-mcpu=cortex-a76+crypto -O2 -pipe"
  export LDFLAGS="-Wl,-z,max-page-size=0x4000"
  export RUSTFLAGS="-C target-cpu=cortex-a76 -C opt-level=2"
  cargo build --release --locked
}

check() {
  cd "$srcdir/dust-1.2.4"
  cargo test --workspace --all-targets --all-features || true
}

package() {
  cd "$srcdir/dust-1.2.4"
  install -Dm755 "target/release/dust" "$pkgdir/usr/bin/dust"
  install -Dm644 "README.md" "$pkgdir/usr/share/doc/dust/README.md"
  install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/dust/LICENSE"
}
