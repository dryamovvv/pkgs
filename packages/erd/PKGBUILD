# Maintainer: dryamovvv <dryamovvv@users.noreply.github.com>
# Contributor: dryamovvv (Arch Linux package)
# Optimized for Raspberry Pi 5 (Cortex-A76)
pkgname=erd
pkgver=3.1.2
pkgrel=1
pkgdesc="A modern, cross-platform filesystem and disk-usage utility, optimized for Raspberry Pi 5 (Cortex-A76)"
arch=('aarch64')
url="https://github.com/solidiquis/erdtree"
license=('MIT')
options=('!debug')
depends=(
  'gcc-libs'
  'glibc'
)
makedepends=(
  'cargo'
)
source=("https://github.com/solidiquis/erdtree/archive/refs/tags/v3.1.2.tar.gz")
sha256sums=('1758e7ad8f7be59bc3c6bda8b058097509f9db6f40ad57c4b0b361e3be439297')

prepare() {
  cd "$srcdir/erdtree-3.1.2"
  cargo fetch --locked
}

build() {
  cd "$srcdir/erdtree-3.1.2"
  export CFLAGS="-mcpu=cortex-a76+crypto -O2 -pipe"
  export CXXFLAGS="-mcpu=cortex-a76+crypto -O2 -pipe"
  export LDFLAGS="-Wl,-z,max-page-size=0x4000"
  export RUSTFLAGS="-C target-cpu=cortex-a76 -C opt-level=2"
  cargo build --release --locked
}

check() {
  cd "$srcdir/erdtree-3.1.2"
  cargo test --workspace --all-targets --all-features || true
}

package() {
  cd "$srcdir/erdtree-3.1.2"
  install -Dm755 "target/release/erd" "$pkgdir/usr/bin/erd"
  install -Dm644 "README.md" "$pkgdir/usr/share/doc/erd/README.md"
  install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/erd/LICENSE"
}
