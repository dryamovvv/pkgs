# Maintainer: dryamovvv <dryamovvv@users.noreply.github.com>
# Contributor: dryamovvv (Arch Linux package)
# Optimized for Raspberry Pi 5 (Cortex-A76)
pkgname=kmscon
pkgver=10.0.0
pkgrel=2
pkgdesc="KMS/DRM terminal emulator optimized for Raspberry Pi 5 (Cortex-A76)"
arch=('aarch64')
url="https://github.com/kmscon/kmscon"
license=('MIT')
depends=(
  'glibc'
  'libdrm'
  'libtsm'
  'libxkbcommon'
  'pango'
  'freetype2'
  'fontconfig'
  'pixman'
  'systemd-libs'
  'zlib'
)
makedepends=(
  'gcc'
  'meson'
  'ninja'
  'python'
  'libxslt'
  'docbook-xsl'
)
options=('!debug')
provides=('kmscon')
conflicts=('kmscon')
backup=('etc/kmscon/kmscon.conf')
source=(
  "kmscon-$pkgver.tar.gz::https://github.com/kmscon/kmscon/archive/refs/tags/v$pkgver.tar.gz"
  "kmscon.conf"
)
sha256sums=('7074956472c42d14977922f9ef6d2ec101f8d88e549f0108c1f51cb9d2b437dd'
            'SKIP')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  export CFLAGS="-mcpu=cortex-a76+crypto -O2 -pipe"
  export CXXFLAGS="-mcpu=cortex-a76+crypto -O2 -pipe"
  export LDFLAGS="-Wl,-z,max-page-size=0x10000"
  meson setup build \
    --prefix=/usr \
    --sysconfdir=/etc \
    --buildtype=release \
    -Dfont_pango=enabled \
    -Dfont_freetype=enabled \
    -Dvideo_drm3d=disabled \
    -Dlibseat=disabled \
    -Ddocs=enabled \
    -Dtests=false
  ninja -C build
}

check() {
  cd "$srcdir/$pkgname-$pkgver"
  ninja -C build test || true
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  DESTDIR="$pkgdir" ninja -C build install

  install -Dm644 "$srcdir/kmscon.conf" "$pkgdir/etc/kmscon/kmscon.conf"
}
