# Maintainer: dryamovvv <dryamovvv@users.noreply.github.com>
# Contributor: dryamovvv (Arch Linux package)
# Optimized for Raspberry Pi 5 (Cortex-A76)
pkgname=fd
pkgver=10.4.2
pkgrel=1
pkgdesc="A simple, fast and user-friendly alternative to find, optimized for Raspberry Pi 5 (Cortex-A76)"
arch=('aarch64')
url="https://github.com/sharkdp/fd"
license=('Apache-2.0')
options=('!debug')
depends=(
  'gcc-libs'
  'glibc'
)
makedepends=(
  'cargo'
)
source=("https://github.com/sharkdp/fd/archive/refs/tags/v10.4.2.tar.gz")
sha256sums=('3a7e027af8c8e91c196ac259c703d78cd55c364706ddafbc66d02c326e57a456')

prepare() {
  cd "$srcdir/fd-10.4.2"
  cargo fetch --locked
}

build() {
  cd "$srcdir/fd-10.4.2"
  export CFLAGS="-mcpu=cortex-a76+crypto -O2 -pipe"
  export CXXFLAGS="-mcpu=cortex-a76+crypto -O2 -pipe"
  export LDFLAGS="-Wl,-z,max-page-size=0x4000"
  export RUSTFLAGS="-C target-cpu=cortex-a76 -C opt-level=2"
  cargo build --release --locked
}

check() {
  cd "$srcdir/fd-10.4.2"
  cargo test --workspace --all-targets --all-features || true
}

package() {
  cd "$srcdir/fd-10.4.2"
  install -Dm755 "target/release/fd" "$pkgdir/usr/bin/fd"
  install -Dm644 "README.md" "$pkgdir/usr/share/doc/fd/README.md"
  install -Dm644 "LICENSE-APACHE" "$pkgdir/usr/share/licenses/fd/LICENSE"
}
