# Maintainer: dryamovvv <dryamovvv@users.noreply.github.com>
# Contributor: dryamovvv (Arch Linux package)
# Optimized for Raspberry Pi 5 (Cortex-A76)
pkgname=zoxide
pkgver=0.9.9
pkgrel=1
pkgdesc="A smarter cd command for your terminal, optimized for Raspberry Pi 5 (Cortex-A76)"
arch=('aarch64')
url="https://github.com/ajeetdsouza/zoxide"
license=('MIT')
options=('!debug')
depends=(
  'gcc-libs'
  'glibc'
)
makedepends=(
  'cargo'
)
source=("https://github.com/ajeetdsouza/zoxide/archive/refs/tags/v0.9.9.tar.gz")
sha256sums=('eddc76e94db58567503a3893ecac77c572f427f3a4eabdfc762f6773abf12c63')

prepare() {
  cd "$srcdir/zoxide-0.9.9"
  cargo fetch --locked
}

build() {
  cd "$srcdir/zoxide-0.9.9"
  export CFLAGS="-mcpu=cortex-a76+crypto -O2 -pipe"
  export CXXFLAGS="-mcpu=cortex-a76+crypto -O2 -pipe"
  export LDFLAGS="-Wl,-z,max-page-size=0x4000"
  export RUSTFLAGS="-C target-cpu=cortex-a76 -C opt-level=2"
  cargo build --release --locked
}

check() {
  cd "$srcdir/zoxide-0.9.9"
  cargo test --workspace --all-targets --all-features || true
}

package() {
  cd "$srcdir/zoxide-0.9.9"
  install -Dm755 "target/release/zoxide" "$pkgdir/usr/bin/zoxide"
  install -Dm644 "README.md" "$pkgdir/usr/share/doc/zoxide/README.md"
  install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/zoxide/LICENSE"
}
