# Maintainer: dryamovvv <dryamovvv@users.noreply.github.com>
# Contributor: dryamovvv (Arch Linux package)
# Optimized for Raspberry Pi 5 (Cortex-A76)
pkgname=delta
pkgver=0.19.2
pkgrel=1
pkgdesc="A syntax-highlighting pager for git, diff, and grep output, optimized for Raspberry Pi 5 (Cortex-A76)"
arch=('aarch64')
url="https://github.com/dandavison/delta"
license=('MIT')
options=('!debug')
depends=(
  'gcc-libs'
  'glibc'
)
makedepends=(
  'cargo'
)
source=("https://github.com/dandavison/delta/archive/refs/tags/0.19.2.tar.gz")
sha256sums=('f59b86f8c8dda4d76a3ba34b8553777a20c3b461646917d8e480fac6531bba9f')

prepare() {
  cd "$srcdir/delta-0.19.2"
  cargo fetch --locked
}

build() {
  cd "$srcdir/delta-0.19.2"
  export CFLAGS="-mcpu=cortex-a76+crypto -O2 -pipe"
  export CXXFLAGS="-mcpu=cortex-a76+crypto -O2 -pipe"
  export LDFLAGS="-Wl,-z,max-page-size=0x4000"
  export RUSTFLAGS="-C target-cpu=cortex-a76 -C opt-level=2"
  cargo build --release --locked
}

check() {
  cd "$srcdir/delta-0.19.2"
  cargo test --workspace --all-targets --all-features || true
}

package() {
  cd "$srcdir/delta-0.19.2"
  install -Dm755 "target/release/delta" "$pkgdir/usr/bin/delta"
  install -Dm644 "README.md" "$pkgdir/usr/share/doc/delta/README.md"
  install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/delta/LICENSE"
}
