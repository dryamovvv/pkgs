# Maintainer: dryamovvv <dryamovvv@users.noreply.github.com>
# Contributor: dryamovvv (Arch Linux package)
# Optimized for Raspberry Pi 5 (Cortex-A76)
pkgname=just
pkgver=1.51.0
pkgrel=1
pkgdesc="A command runner, optimized for Raspberry Pi 5 (Cortex-A76)"
arch=('aarch64')
url="https://github.com/casey/just"
license=('CC0-1.0')
options=('!debug')
depends=(
  'gcc-libs'
  'glibc'
)
makedepends=(
  'cargo'
)
source=("https://github.com/casey/just/archive/refs/tags/1.51.0.tar.gz")
sha256sums=('ed424dcf55ec08e22a0c58f6cfb7333573775d69dac3802bf0c1d96f7557089d')

prepare() {
  cd "$srcdir/just-1.51.0"
  cargo fetch --locked
}

build() {
  cd "$srcdir/just-1.51.0"
  export CFLAGS="-mcpu=cortex-a76+crypto -O2 -pipe"
  export CXXFLAGS="-mcpu=cortex-a76+crypto -O2 -pipe"
  export LDFLAGS="-Wl,-z,max-page-size=0x4000"
  export RUSTFLAGS="-C target-cpu=cortex-a76 -C opt-level=2"
  cargo build --release --locked
}

check() {
  cd "$srcdir/just-1.51.0"
  cargo test --workspace --all-targets --all-features || true
}

package() {
  cd "$srcdir/just-1.51.0"
  install -Dm755 "target/release/just" "$pkgdir/usr/bin/just"
  install -Dm644 "README.md" "$pkgdir/usr/share/doc/just/README.md"
  install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/just/LICENSE"
}
