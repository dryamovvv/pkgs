# Maintainer: dryamovvv <dryamovvv@users.noreply.github.com>
# Contributor: dryamovvv (Arch Linux package)
# Optimized for Raspberry Pi 5 (Cortex-A76)
pkgname=grex
pkgver=1.4.6
pkgrel=1
pkgdesc="A command-line tool for generating regular expressions, optimized for Raspberry Pi 5 (Cortex-A76)"
arch=('aarch64')
url="https://github.com/pemistahl/grex"
license=('Apache-2.0')
options=('!debug')
depends=(
  'gcc-libs'
  'glibc'
)
makedepends=(
  'cargo'
)
source=("https://github.com/pemistahl/grex/archive/refs/tags/1.4.6.tar.gz")
sha256sums=('2ab9cb4c3d921711f23ea33a9e60dc11e9eaab450b16d1f2247bea2276822433')

prepare() {
  cd "$srcdir/grex-1.4.6"
  cargo fetch --locked
}

build() {
  cd "$srcdir/grex-1.4.6"
  export CFLAGS="-mcpu=cortex-a76+crypto -O2 -pipe"
  export CXXFLAGS="-mcpu=cortex-a76+crypto -O2 -pipe"
  export LDFLAGS="-Wl,-z,max-page-size=0x4000"
  export RUSTFLAGS="-C target-cpu=cortex-a76 -C opt-level=2"
  cargo build --release --locked
}

check() {
  cd "$srcdir/grex-1.4.6"
  cargo test --workspace --all-targets --all-features || true
}

package() {
  cd "$srcdir/grex-1.4.6"
  install -Dm755 "target/release/grex" "$pkgdir/usr/bin/grex"
  install -Dm644 "README.md" "$pkgdir/usr/share/doc/grex/README.md"
  install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/grex/LICENSE"
}
