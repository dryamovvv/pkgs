# Maintainer: dryamovvv <dryamovvv@users.noreply.github.com>
# Contributor: dryamovvv (Arch Linux package)
# Optimized for Raspberry Pi 5 (Cortex-A76)
pkgname=arch-ops-server
pkgver=3.5.0
pkgrel=1
pkgdesc="MCP server bridging AI assistants with Arch Linux ecosystem (Wiki, AUR, repos, system management) optimized for Raspberry Pi 5 (Cortex-A76)"
arch=('aarch64')
url="https://github.com/dryamovvv/arch-mcp"
license=('GPL3' 'MIT')
depends=('python>=3.11')
optdepends=(
  'btrfs-progs: BTRFS monitoring and management'
  'snapper: BTRFS snapshot management'
  'rpi-eeprom: RPi bootloader management'
  'pacman: package management (standard Arch)'
  'paru: AUR helper for package installation'
)
makedepends=('uv')
install=arch-ops-server.install
options=('!debug')
source=("$pkgname-$pkgver.tar.gz::https://github.com/dryamovvv/arch-mcp/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('daa5052eaf67be71e8c45a95f4eb8daa42ae6a2d458ec036ef1e692c6e3f9d62')

build() {
  cd "$srcdir/arch-mcp-$pkgver"
  export CFLAGS="-mcpu=cortex-a76+crypto -O2 -pipe"
  export CXXFLAGS="-mcpu=cortex-a76+crypto -O2 -pipe"
  export LDFLAGS="-Wl,-z,max-page-size=0x4000"

  _vendor="$srcdir/vendor"

  uv pip install \
    --target "$_vendor" \
    --python /usr/bin/python \
    ".[http]"

  cat > "$_vendor/bin/arch-ops-server" << 'WRAPPER'
#!/bin/sh
exec /usr/bin/env PYTHONPATH=/opt/arch-ops-server/vendor \
    /usr/bin/python -c 'from arch_ops_server import main_sync; import sys; sys.exit(main_sync())'
WRAPPER
  chmod 755 "$_vendor/bin/arch-ops-server"

  cat > "$_vendor/bin/arch-ops-server-http" << 'WRAPPER'
#!/bin/sh
exec /usr/bin/env PYTHONPATH=/opt/arch-ops-server/vendor \
    /usr/bin/python -c 'from arch_ops_server import main_http_sync; import sys; sys.exit(main_http_sync())'
WRAPPER
  chmod 755 "$_vendor/bin/arch-ops-server-http"
}

check() {
  cd "$srcdir/arch-mcp-$pkgver"
  uv run pytest || true
}

package() {
  cd "$srcdir/arch-mcp-$pkgver"

  _vendor="/opt/$pkgname/vendor"

  cp -r "$srcdir/vendor" "$pkgdir$_vendor"

  mkdir -p "$pkgdir/usr/bin"
  ln -s "$_vendor/bin/arch-ops-server" "$pkgdir/usr/bin/arch-ops-server"
  ln -s "$_vendor/bin/arch-ops-server-http" "$pkgdir/usr/bin/arch-ops-server-http"

  install -Dm644 packaging/arch/arch-ops-server.service \
    "$pkgdir/etc/systemd/system/arch-ops-server.service"
}